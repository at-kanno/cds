# Active subject profile (must match a top-level key in static/config.json)
APP_PROFILE=CDS

# Database file is chosen automatically:
#   exam-{APP_PROFILE}.sqlite  (e.g. exam-CDS.sqlite, exam-SPANISH4.sqlite)
# For CDS only, legacy exam.sqlite is still used if exam-CDS.sqlite is absent.
# Optional override:
# EXAM_DB_PATH=/home/ubuntu/cds/backend/exam-SPANISH4.sqlite

# Optional: override config file path
# CONFIG_PATH=/home/ubuntu/cds/backend/static/config.json
