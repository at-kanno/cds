[Unit]
Description=CDS Flask Backend (APP_PROFILE=CDS)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/cds/backend
Environment="PATH=/home/ubuntu/cds/backend/.venv/bin"
EnvironmentFile=/home/ubuntu/cds/backend/.env
# Set APP_PROFILE=CDS in .env
# Apache sends X-Forwarded-Prefix; do NOT set SCRIPT_NAME here.
ExecStart=/home/ubuntu/cds/backend/.venv/bin/gunicorn \
  --bind 127.0.0.1:8080 \
  --workers 2 \
  --timeout 120 \
  "index:app"
Restart=always

[Install]
WantedBy=multi-user.target
