[Unit]
Description=CDS Flask Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/cds/backend
Environment="PATH=/home/ubuntu/cds/backend/.venv/bin"
EnvironmentFile=/home/ubuntu/cds/backend/.env
# Set APP_PROFILE in .env (e.g. APP_PROFILE=CDS or APP_PROFILE=TOEIC).
# Apache sends X-Forwarded-Prefix per subject path; do NOT set SCRIPT_NAME here.
ExecStart=/home/ubuntu/cds/backend/.venv/bin/gunicorn \
  --bind 127.0.0.1:8080 \
  --workers 2 \
  --timeout 120 \
  "index:app"
Restart=always

[Install]
WantedBy=multi-user.target
