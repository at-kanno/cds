# Apache configuration for https://traveltokio.com/cds
#
# Prefer adding deploy/apache/cds-proxy-snippet.conf to the EXISTING
# 000-default-le-ssl.conf instead of using this as a separate site.
#
# Setup on EC2:
#   sudo a2enmod proxy proxy_http headers ssl rewrite
#   sudo a2dissite cds
#   Edit /etc/apache2/sites-available/000-default-le-ssl.conf (see snippet)
#   Do NOT set SCRIPT_NAME in cds.service
#   sudo apache2ctl configtest && sudo systemctl reload apache2

<VirtualHost *:443>
    ServerName traveltokio.com

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/traveltokio.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/traveltokio.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    RedirectMatch permanent ^/cds$ /cds/

    RequestHeader set X-Forwarded-Prefix "/cds"
    ProxyPreserveHost On
    ProxyPass /cds/ http://127.0.0.1:8080/
    ProxyPassReverse /cds/ http://127.0.0.1:8080/

    ErrorLog ${APACHE_LOG_DIR}/cds-error.log
    CustomLog ${APACHE_LOG_DIR}/cds-access.log combined
</VirtualHost>
